# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session
SESSION_SECRET=your-session-secret-here

# VAPID (Push notifications)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server
PORT=5000

# Firebase service account JSON (single-line string) for FCM delivery to the
# KMP app: Firebase Console → Project settings → Service accounts →
# Generate new private key, then compact the JSON to one line.
# If unset, the FCM cron branch is skipped (web push + Expo push unaffected).
FIREBASE_SERVICE_ACCOUNT_JSON=
