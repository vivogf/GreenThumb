# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session
SESSION_SECRET=your-session-secret-here

# VAPID (Push notifications)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server (ecosystem.config.cjs forces HOST=127.0.0.1 and PORT=5000 in production)
HOST=
PORT=5000

# Firebase service account JSON (single-line string) for FCM delivery to the
# KMP app: Firebase Console → Project settings → Service accounts →
# Generate new private key, then compact the JSON to one line.
# If unset, the FCM cron branch is skipped (web push + Expo push unaffected).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare R2 (EU). Backups: scripts/ops/backup.mjs; photos: server/photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PHOTOS=
R2_BUCKET_BACKUPS=
# Origin used in stored photo URLs: <PHOTO_PUBLIC_BASE_URL>/photos/<uuid>.<ext>
PHOTO_PUBLIC_BASE_URL=

# Pl@ntNet species identification (server-side only). Daily caps per UTC day;
# defaults 450 global and 20 per user when unset.
PLANTNET_API_KEY=
PLANTNET_DAILY_LIMIT=
PLANTNET_USER_DAILY_LIMIT=

# AI diagnosis (server-side only). DIAGNOSIS_PROVIDER=openai enables it; unset means disabled (503).
# DIAGNOSIS_MODEL defaults to gpt-6-luna; DIAGNOSIS_USER_DAILY_LIMIT to 10 per user per UTC day.
DIAGNOSIS_PROVIDER=
DIAGNOSIS_MODEL=
DIAGNOSIS_USER_DAILY_LIMIT=
OPENAI_API_KEY=

# Android Digital Asset Links (/.well-known/assetlinks.json). Uppercase colon-separated
# SHA-256 signing-cert fingerprints, comma-separated. A package's statement is published
# only when its variable is non-empty.
ASSETLINKS_FINGERPRINTS_DEBUG=
ASSETLINKS_FINGERPRINTS_RELEASE=
