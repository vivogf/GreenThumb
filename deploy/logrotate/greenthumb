# Install as /etc/logrotate.d/greenthumb
/var/log/greenthumb-*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

/root/.pm2/logs/greenthumb-*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
