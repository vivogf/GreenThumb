# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session
SESSION_SECRET=your-session-secret-here

# VAPID (Push notifications)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server (ecosystem.config.cjs forces HOST=127.0.0.1 and PORT=5000 in production)
HOST=
PORT=5000

# Firebase service account JSON (single-line string) for FCM delivery to the
# KMP app: Firebase Console → Project settings → Service accounts →
# Generate new private key, then compact the JSON to one line.
# If unset, the FCM cron branch is skipped (web push + Expo push unaffected).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare R2 (EU). Backups: scripts/ops/backup.mjs; photos: server/photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PHOTOS=
R2_BUCKET_BACKUPS=
# Origin used in stored photo URLs: <PHOTO_PUBLIC_BASE_URL>/photos/<uuid>.<ext>
PHOTO_PUBLIC_BASE_URL=
